# Copy to backend/.env. Obtain real URLs privately from your managed PostgreSQL provider.
APP_ENV=development
DATABASE_URL=
# Prefer a direct, non-pooled URL for migrations.
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=
TEST_DATABASE_HOST=
TEST_DATABASE_NAME=graceshield_test
ALLOW_TEST_DATABASE=false
FRONTEND_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
SESSION_HOURS=24
ALLOW_DEMO_SEED=false
# No default shipping fee or coverage is invented. Configure explicitly for development.
SHIPPING_FEE_MINOR=
SHIPPING_REGIONS=
RESERVATION_MINUTES=15
EMAIL_ENABLED=false
EMAIL_API_URL=
EMAIL_API_TOKEN=
EMAIL_FROM=
